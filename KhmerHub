            b.MouseLeave:Connect(function() tween(b, {BackgroundColor3 = T.SurfaceAlt}, 0.12) end)
            b.MouseButton1Click:Connect(function()
                if opts.Callback then task.spawn(opts.Callback) end
            end)
            return b
        end

        function section:Toggle(opts)
            local flag = opts.Flag
            local value = opts.Default or false

            local row = create("Frame", {
                Size = UDim2.new(1, 0, 0, 34),
                BackgroundTransparency = 1,
                Parent = section.Holder,
            })

            create("TextLabel", {
                Size = UDim2.new(1, -70, 1, 0),
                BackgroundTransparency = 1,
                Font = Enum.Font.Gotham,
                TextSize = 13,
                TextColor3 = T.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = opts.Name,
                Parent = row,
            })

            local switch = create("Frame", {
                Size = UDim2.fromOffset(48, 26),
                Position = UDim2.new(1, -48, 0.5, -13),
                BackgroundColor3 = value and T.Accent or T.ToggleOff,
                BorderSizePixel = 0,
                Parent = row,
            }, {corner(13)})

            local knob = create("Frame", {
                Size = UDim2.fromOffset(20, 20),
                Position = value and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
                Parent = switch,
            }, {corner(10)})

            local function set(v, silent)
                value = v
                tween(switch, {BackgroundColor3 = v and T.Accent or T.ToggleOff}, 0.14)
                tween(knob, {
                    Position = v and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
                }, 0.14)
                if flag then UI.Flags[flag] = v end
                if not silent and opts.Callback then task.spawn(opts.Callback, v) end
            end

            switch.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    set(not value)
                end
            end)

            if flag then
                UI.Flags[flag] = value
                UI.Elements[flag] = {
                    Set = function(_, v) set(v, true) end,
                    Get = function() return value end,
                }
            end
        end

        function section:Slider(opts)
            local flag = opts.Flag
            local min = opts.Min or 0
            local max = opts.Max or 100
            local decimals = opts.Decimals or 0
            local suffix = opts.Suffix or ""
            local value = opts.Default or min

            local row = create("Frame", {
                Size = UDim2.new(1, 0, 0, 48),
                BackgroundTransparency = 1,
                Parent = section.Holder,
            })

            create("TextLabel", {
                Size = UDim2.new(1, -70, 0, 18),
                BackgroundTransparency = 1,
                Font = Enum.Font.Gotham,
                TextSize = 13,
                TextColor3 = T.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = opts.Name,
                Parent = row,
            })

            local valueLabel = create("TextLabel", {
                Size = UDim2.new(0, 70, 0, 18),
                Position = UDim2.new(1, -70, 0, 0),
                BackgroundTransparency = 1,
                Font = Enum.Font.Gotham,
                TextSize = 13,
                TextColor3 = T.TextDim,
                TextXAlignment = Enum.TextXAlignment.Right,
                Text = tostring(value) .. suffix,
                Parent = row,
            })

            local track = create("Frame", {
                Size = UDim2.new(1, 0, 0, 10),
                Position = UDim2.new(0, 0, 0, 30),
                BackgroundColor3 = T.ToggleOff,
                BorderSizePixel = 0,
                Parent = row,
            }, {corner(5)})

            local fill = create("Frame", {
                Size = UDim2.new(0, 0, 1, 0),
                BackgroundColor3 = T.Accent,
                BorderSizePixel = 0,
                Parent = track,
            }, {corner(5)})

            local knob = create("Frame", {
                Size = UDim2.fromOffset(18, 18),
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0, 0, 0.5, 0),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
                Parent = track,
            }, {corner(9)})

            local dragging = false

            local function fmt(v)
                if decimals <= 0 then return tostring(math.floor(v + 0.5)) end
                return string.format("%." .. decimals .. "f", v)
            end

            local function set(v, silent)
                v = math.clamp(v, min, max)
                value = v
                local alpha = (max == min) and 0 or (v - min) / (max - min)
                fill.Size = UDim2.new(alpha, 0, 1, 0)
                knob.Position = UDim2.new(alpha, 0, 0.5, 0)
                valueLabel.Text = fmt(v) .. suffix
                if flag then UI.Flags[flag] = v end
                if not silent and opts.Callback then task.spawn(opts.Callback, v) end
            end

            local function fromX(x)
                local abs = track.AbsolutePosition.X
                local size = track.AbsoluteSize.X
                if size <= 0 then return end
                local alpha = math.clamp((x - abs) / size, 0, 1)
                set(min + (max - min) * alpha)
            end

            track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    fromX(input.Position.X)
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if not dragging then return end
                if input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch then
                    fromX(input.Position.X)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            if flag then
                UI.Flags[flag] = value
          
